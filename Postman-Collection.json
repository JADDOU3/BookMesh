    {
      "name": "Introspection",
      "description": "Handy when you want Postman's GraphQL autocomplete without attaching a schema file.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Schema types",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Introspect {\n  __schema {\n    queryType { name }\n    mutationType { name }\n    types {\n      name\n      kind\n      fields {\n        name\n        type { name kind ofType { name kind } }\n      }\n    }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Fails if introspection is disabled in production config."
          },
          "response": []
        }
      ]
    }
  ]
